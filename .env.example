# Optional: require X-API-Key for mutating API requests.
BLACKBOARD_API_KEY=replace-with-a-long-random-secret

# Runtime configuration.
BLACKBOARD_DB_PATH=data/blackboard.db
CORS_ORIGINS=http://localhost:8000
HEARTBEAT_TIMEOUT=60
HEARTBEAT_CHECK_INTERVAL=30
WEBSOCKET_MAX_MESSAGE_BYTES=65536
WEBSOCKET_MAX_CHANNELS=64
HOST=0.0.0.0
PORT=8000
